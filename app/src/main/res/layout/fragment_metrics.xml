<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:clipToPadding="false"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- SUBTITLE HEADINGS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Know your body."
            android:textColor="@color/text_dark"
            android:textSize="32sp"
            app:fontFamily="@font/roboto_medium"
             />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Your numbers. Your goals. Your starting point."
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <!-- INPUT CARD CONTAINER -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- ICON BADGE -->
                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icon_badge"
                    android:padding="10dp"
                    android:src="@drawable/ic_metrics"
                    app:tint="@color/primary_orange" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Your body, by the numbers"
                    android:textColor="@color/text_dark"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:fontFamily="@font/poppins_semibold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="A few details to find your daily baseline."
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

                <!-- SEX SPINNER -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Sex used for calculation"
                    android:textSize="13sp"
                    />

                <Spinner
                    android:id="@+id/spinner_sex"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_metric_input"
                    android:paddingHorizontal="16dp"
                    />

                <!-- AGE & HEIGHT ROW -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <!-- AGE INPUT -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Age"
                            android:textColor="@color/text_muted"
                            android:textSize="13sp" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_metric_input"
                            android:paddingHorizontal="16dp">

                            <EditText
                                android:id="@+id/et_age"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_toStartOf="@id/tv_unit_years"
                                android:background="@null"
                                android:inputType="number"
                                android:textColor="@color/text_dark"
                                android:textSize="18sp"
                                app:fontFamily="@font/font_poppins" />

                            <TextView
                                android:id="@+id/tv_unit_years"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:text="years"
                                android:textColor="@color/text_muted"
                                android:textSize="12sp" />
                        </RelativeLayout>
                    </LinearLayout>

                    <!-- HEIGHT INPUT -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Height"
                            android:textColor="@color/text_muted"
                            android:textSize="13sp" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_metric_input"
                            android:paddingHorizontal="16dp">

                            <EditText
                                android:id="@+id/et_height"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_toStartOf="@id/tv_unit_cm"
                                android:background="@null"
                                android:inputType="number"
                                android:textColor="@color/text_dark"
                                android:textSize="18sp"
                                app:fontFamily="@font/font_poppins" />

                            <TextView
                                android:id="@+id/tv_unit_cm"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:text="cm"
                                android:textColor="@color/text_muted"
                                android:textSize="12sp" />
                        </RelativeLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- WEIGHT INPUT -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Weight"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_metric_input"
                    android:paddingHorizontal="16dp">

                    <EditText
                        android:id="@+id/et_weight"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_toStartOf="@id/tv_unit_kg"
                        android:background="@null"
                        android:inputType="numberDecimal"
                        android:textColor="@color/text_dark"
                        android:textSize="18sp"
                        app:fontFamily="@font/font_poppins" />

                    <TextView
                        android:id="@+id/tv_unit_kg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="kg"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />
                </RelativeLayout>

                <!-- ACTIVITY LEVEL SPINNER -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Activity level"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/spinner_activity"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_metric_input"
                    android:paddingHorizontal="16dp" />

                <!-- CALCULATE BUTTON -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_calculate_metrics"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_orange_button"
                    android:text="Calculate my metrics  →"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    app:fontFamily="@font/poppins_semibold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:text="Your measurements stay on this device."
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- BASELINE CARD SECTION -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- SECTION HEADER -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="Your baseline"
                        android:textColor="@color/text_dark"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/poppins_semibold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_metric_input"
                        android:letterSpacing="0.06"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="THE STARTING LINE"
                        android:textColor="@color/text_muted"
                        android:textSize="8sp"
                        app:fontFamily="@font/font_poppins" />
                </RelativeLayout>

                <!-- 1. BEFORE CALCULATION: EMPTY STATE -->
                <LinearLayout
                    android:id="@+id/layout_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="275dp"
                    android:background="@drawable/bg_empty_baseline"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="32dp"
                    android:visibility="visible">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/ic_target"
                        app:tint="#8C9A8A" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:text="Every goal has a starting point."
                        android:textColor="@color/text_dark"
                        android:textSize="16sp"
                        app:fontFamily="@font/roboto_medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="Enter your details and calculate to see your BMI, resting metabolism, and daily energy needs."
                        android:textColor="@color/text_muted"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- 2. AFTER CALCULATION: CALCULATED RESULTS STATE -->
                <LinearLayout
                    android:id="@+id/layout_results_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- BMI CARD -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_metric_card_light"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.06"
                                android:text="BODY MASS INDEX"
                                android:textColor="@color/text_muted"
                                android:textSize="10sp"
                                app:fontFamily="@font/poppins_semibold" />

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_alignParentEnd="true"
                                android:src="@drawable/ic_pulse"
                                app:tint="#8C9A8A" />
                        </RelativeLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="bottom">

                            <TextView
                                android:id="@+id/tv_bmi_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="23.7"
                                android:textColor="@color/text_dark"
                                android:textSize="36sp"
                                android:textStyle="bold"
                                app:fontFamily="@font/font_poppins" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_marginBottom="6dp"
                                android:text="BMI"
                                android:textColor="@color/text_muted"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                app:fontFamily="@font/font_poppins" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_bmi_category"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Healthy weight range"
                            android:letterSpacing="0.03"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- BMR CARD -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_metric_card_light"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.06"
                                android:text="BASAL METABOLIC RATE"
                                android:textColor="@color/text_muted"
                                android:textSize="10sp"
                                app:fontFamily="@font/poppins_semibold" />

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_alignParentEnd="true"
                                android:src="@drawable/ic_flame"
                                app:tint="#8C9A8A" />
                        </RelativeLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="bottom">

                            <TextView
                                android:id="@+id/tv_bmr_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1,743"
                                android:textColor="@color/text_dark"
                                android:textSize="36sp"
                                android:textStyle="bold"
                                app:fontFamily="@font/font_poppins" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_marginBottom="6dp"
                                android:text="kcal / day"
                                android:textColor="@color/text_muted"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="The energy your body uses at rest."
                            android:textColor="@color/text_muted"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- TDEE DARK CARD -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_metric_card_dark"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.06"
                                android:text="DAILY CALORIE NEEDS · TDEE"
                                android:textColor="@color/primary_orange"
                                android:textSize="10sp"
                                app:fontFamily="@font/poppins_semibold" />

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_alignParentEnd="true"
                                android:src="@drawable/ic_lightning"
                                app:tint="@color/primary_orange" />
                        </RelativeLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="bottom">

                            <TextView
                                android:id="@+id/tv_tdee_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2,701"
                                android:textColor="@android:color/white"
                                android:textSize="36sp"
                                android:textStyle="bold"
                                app:fontFamily="@font/font_poppins" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_marginBottom="6dp"
                                android:text="kcal / day"
                                android:textColor="#A0A89C"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Estimated calories to maintain your weight."
                            android:textColor="#A0A89C"
                            android:letterSpacing="0.03"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- FOOTNOTE -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="A guide, not a diagnosis. BMI doesn’t account for muscle mass. BMR uses the Mifflin–St Jeor equation. These are estimates for adults; consult a qualified professional for personalized advice."
                    android:letterSpacing="0.03"
                    android:lineSpacingExtra="5sp"
                    android:textColor="@color/text_muted"
                    android:textSize="9sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>