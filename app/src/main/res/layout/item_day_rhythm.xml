<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRhythmRoot"
    android:layout_width="140dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:background="@drawable/bg_orange_tint_card"
    android:orientation="vertical"
    android:padding="12dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvDayName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MON"
            android:textColor="@color/primary_orange"
            android:textSize="11sp"
            android:textStyle="bold"
            app:fontFamily="@font/font_poppins" />

        <TextView
            android:id="@+id/tvBadgeSelected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_icon_badge"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:text="SELECTED"
            android:textColor="@color/primary_orange"
            android:textSize="8sp"
            android:textStyle="bold"
            app:fontFamily="@font/font_poppins" />
    </RelativeLayout>

    <ImageView
        android:id="@+id/ivWorkoutIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/ic_dumbbell"
        app:tint="@color/primary_orange" />

    <TextView
        android:id="@+id/tvWorkoutTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Push day"
        android:textColor="@color/text_dark"
        android:textSize="15sp"
        android:textStyle="bold"
        app:fontFamily="@font/font_poppins" />

    <TextView
        android:id="@+id/tvSubText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="6 exercises · 48 min"
        android:textColor="@color/text_muted"
        android:textSize="10sp" />

    <View
        android:id="@+id/dividerLine"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#F2D2C6" />

    <RelativeLayout
        android:id="@+id/layoutBottomStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/tvActionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Let's get to work"
            android:textColor="@color/primary_orange"
            android:textSize="10sp"
            android:textStyle="bold"
            app:fontFamily="@font/font_poppins" />

        <TextView
            android:id="@+id/tvActionArrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="→"
            android:textColor="@color/primary_orange"
            android:textSize="10sp" />
    </RelativeLayout>
</LinearLayout>