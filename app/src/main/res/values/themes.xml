<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.RepUp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary Brand Color -->
        <item name="colorPrimary">@color/primary_orange</item>
        <item name="colorOnPrimary">@color/text_light</item>

        <!-- App Background -->
        <item name="android:windowBackground">@color/app_background</item>
        <item name="colorSurface">@color/card_background</item>

        <!-- Status Bar Configuration -->
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- font -->
        <item name="fontFamily">@font/font_roboto</item>
        <item name="android:fontFamily">@font/font_roboto</item>
    </style>
</resources>